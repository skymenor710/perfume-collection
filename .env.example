# Meus Perfumes — variáveis de ambiente.
#
# Copie para `.env.local` (lido pelo servidor; nunca vai para o Git) e preencha só o que for usar.
# Tudo aqui é opcional no computador: sem nada preenchido o app roda como hoje (porta 3100, dados em ./data).
# NUNCA coloque valores reais neste arquivo — ele é versionado.

# ── Servidor local ───────────────────────────────────────────────────────────
# Porta HTTP (padrão 3100).
PERFUMES_PORT=
# Interface de rede: 0.0.0.0 libera o celular na mesma Wi-Fi (padrão); 127.0.0.1 = só este computador.
PERFUMES_HOST=
# Pasta dos dados (library.json, fotos, cache). Padrão: ./data
PERFUMES_DATA_DIR=
# Pasta do modelo de recorte de 224 MB. Padrão: ./data/models
PERFUMES_MODELS_DIR=
# Código que libera o celular na Wi-Fi. Gerado sozinho no primeiro start e gravado no .env.local.
PERFUMES_ACCESS_CODE=
# Dono desta instalação enquanto não há contas (vira /username).
PERFUMES_USERNAME=
PERFUMES_DISPLAY_NAME=
# Endereço público quando hospedado (ex.: https://perfumes.exemplo.com). Vazio = só este PC e a Wi-Fi.
PERFUMES_PUBLIC_ORIGIN=
# Nível dos logs estruturados: fatal | error | warn | info | debug | trace | silent (padrão info).
LOG_LEVEL=

# ── Rede de saída (proteção contra abuso) ───────────────────────────────────
# Pedidos externos simultâneos (padrão 6) e por minuto (padrão 120) somando todas as fontes.
EGRESS_MAX_CONCURRENT=
EGRESS_MAX_PER_MINUTE=

# ── Busca na web ─────────────────────────────────────────────────────────────
# Chave da Brave Search API (plano gratuito). Sem ela, a identidade vem do catálogo e das lojas oficiais.
SEARCH_PROVIDER_KEY=
# Nome antigo, ainda aceito:
BRAVE_SEARCH_API_KEY=
# Fontes desligadas, separadas por vírgula: product-page, parfumo, official-stores, fragrantica, brave, duckduckgo, resellers
SOURCES_DISABLED=

# ── Banco (FASE 2) ───────────────────────────────────────────────────────────
# Fonte oficial da coleção: json (data/library.json, padrão) ou postgres.
STORAGE_BACKEND=
# Postgres do Neon ("Connection string" do painel, com ?sslmode=require). Um banco/branch por ambiente:
# desenvolvimento, staging e produção nunca compartilham a mesma URL.
# Fora de produção também aceita pglite:<pasta> (Postgres local de ensaio, sem conta).
DATABASE_URL=
# Conexão direta do Neon (host sem "-pooler"), usada só para aplicar migrations. Opcional.
DATABASE_URL_UNPOOLED=
# Id do dono desta instalação no banco (só se houver mais de um usuário).
PERFUMES_OWNER_ID=
# Banco EXCLUSIVO para testes (os testes apagam tudo nele). Opcional: sem ele, os testes usam PGlite.
TEST_DATABASE_URL=

# ── Produção (FASE 3+; ainda NÃO usados pelo app) ───────────────────────────
# Cloudflare R2 (fotos).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Better Auth (mínimo 32 caracteres aleatórios).
AUTH_SECRET=
# E-mail de login (Resend).
EMAIL_PROVIDER_KEY=
# Monitoramento de erros.
SENTRY_DSN=
