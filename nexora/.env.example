# ---------------------------------------------------------------------------
# NEXORA — configuration (copier en .env et remplir). Aucun secret ici.
# Toutes ces valeurs restent sur le serveur : rien n'est envoyé au navigateur.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Adresse publique exacte du site (https en production). Sert aux liens canoniques, au contrôle d'origine (CSRF)
# et active les cookies Secure + HSTS quand elle commence par https://.
PUBLIC_URL=http://localhost:3000
# true UNIQUEMENT derrière UN proxy/hébergeur de confiance qui AJOUTE l'adresse du visiteur à X-Forwarded-For
# (Render, Fly, Nginx…) : seule la dernière adresse de l'en-tête est utilisée. Jamais sur Netlify.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Base de données -------------------------------------------------------
# PostgreSQL (recommandé en production : Neon, Supabase, Scaleway, OVH, serveur dédié) :
#   DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nexora?sslmode=require
# PostgreSQL embarqué (développement ou serveur unique avec disque persistant) :
DATABASE_URL=pglite:./data/db
# Applique les migrations au démarrage (sinon : npm run db:migrate).
MIGRATE_ON_START=true

# --- Sessions --------------------------------------------------------------
# OBLIGATOIRE en production : 32 caractères aléatoires minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# auto = Secure si PUBLIC_URL est en https
COOKIE_SECURE=auto

# --- Stockage des images ---------------------------------------------------
# local : dossier sur un disque PERSISTANT (jamais /tmp ni le disque éphémère d'une fonction serverless)
# s3    : stockage compatible S3 (Cloudflare R2, Scaleway Object Storage, OVH, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
# Exemple Cloudflare R2 :
#   S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=nexora-media
#   S3_ACCESS_KEY_ID=
#   S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Taille maximale d'une image envoyée dans l'admin (Mo)
UPLOAD_MAX_MB=12

# --- Notification e-mail des demandes de contact ---------------------------
# none | resend | brevo. Sans configuration, les demandes sont enregistrées et visibles dans /admin, sans e-mail.
MAIL_PROVIDER=none
MAIL_API_KEY=
# Expéditeur validé chez le fournisseur, ex. : Nexora <site@votre-domaine.fr>
MAIL_FROM=
# Destinataire(s) des notifications, séparés par des virgules
MAIL_TO=


# Mesure d'audience (facultative). Rien n'est chargé sans consentement : un bandeau demande l'accord du visiteur,
# et le script n'est inséré qu'après « Accepter ». none = aucun outil tiers (par défaut).
# Exemple Plausible : ANALYTICS_PROVIDER=plausible et ANALYTICS_DOMAIN=www.votre-domaine.fr
ANALYTICS_PROVIDER=none
ANALYTICS_DOMAIN=
# ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.manual.js   (ou l'adresse de votre instance auto-hébergée)

# --- Observabilité serveur (facultative, Sentry) ---------------------------
# Erreurs et performances des fonctions Netlify. Rien n'est chargé dans le navigateur ; les cookies, IP, en-têtes,
# corps de requête, paramètres d'URL et valeurs SQL sont explicitement exclus avant l'envoi.
SENTRY_DSN=
# 10 % des requêtes sont tracées : réduisez à 0 pour désactiver les traces tout en gardant les erreurs.
SENTRY_TRACES_SAMPLE_RATE=0.1
