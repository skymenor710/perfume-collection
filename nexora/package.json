{
  "name": "nexora-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site public, API et administration de Nexora (création de sites web).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --import tsx --watch src/server/main.ts",
    "build": "vite build",
    "brand:logo": "python3 -I assets-src/logo4k/trace.py && python3 -I assets-src/logo4k/wordmark.py && node assets-src/logo4k/rasterize.mjs 3840 && python3 -I assets-src/logo4k/compose.py 3840 && node assets-src/logo4k/export.mjs",
    "start": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:typed": "eslint --config eslint.config.typed.mjs .",
    "lint:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:netlify": "npm run build && node scripts/netlify-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run lint:typed && npm run lint:rules && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.1",
    "@sentry/node": "^11.8.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.13",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/figtree": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.2"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": {
        "@esbuild-kit/core-utils": {
          "esbuild": "0.25.12"
        }
      }
    }
  }
}
