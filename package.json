{
  "name": "perfume-collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coleção pessoal de perfumes: wishlist e coleção num seletor de personagem 3D, com a galáxia tingida pela cor de cada frasco.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run build && npm run server",
    "server": "tsx apps/server/src/main.ts",
    "dev": "npm run dev -w @perfumes/web",
    "build": "npm run build -w @perfumes/web",
    "build:artifact": "node scripts/build-artifact.mjs",
    "preview": "npm run preview -w @perfumes/web",
    "test": "vitest run",
    "test:neon": "node scripts/test-neon.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/server/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:artifact": "node scripts/smoke-artifact.mjs",
    "state:verify": "node scripts/verify-state.mjs",
    "db:generate": "npm run db:generate -w @perfumes/server",
    "db:backup": "tsx apps/server/src/db/cli/backup.ts",
    "db:migrate": "tsx apps/server/src/db/cli/migrate.ts",
    "db:status": "tsx apps/server/src/db/cli/migrate.ts --status",
    "db:import": "tsx apps/server/src/db/cli/import.ts",
    "db:verify": "tsx apps/server/src/db/cli/verify.ts",
    "db:export": "tsx apps/server/src/db/cli/export.ts",
    "db:rollback-json": "tsx apps/server/src/db/cli/rollback-json.ts",
    "db:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-db.ps1",
    "db:targets": "tsx apps/server/src/db/cli/targets.ts",
    "seed:research": "tsx scripts/research-seed.ts",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1",
    "app:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -Stop",
    "app:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "tsx": "4.23.15",
    "sharp": "0.35.4"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": {
        "@esbuild-kit/core-utils": {
          "esbuild": "0.25.12"
        }
      }
    }
  }
}
